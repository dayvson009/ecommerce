<script>
// Countdown timer para o upsell
let timeLeft = 600; // 10 minutos em segundos

function updateCountdown() {
  const minutes = Math.floor(timeLeft / 60);
  const seconds = timeLeft % 60;
  document.getElementById('countdown').textContent = 
    `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
  
  if (timeLeft > 0) {
    timeLeft--;
    setTimeout(updateCountdown, 1000);
  } else {
    document.getElementById('countdown').textContent = 'Expirado';
  }
}

// Iniciar countdown
updateCountdown();

// Funções do upsell
function acceptUpsell() {
  // Redirecionar para checkout do upsell
  window.open('https://kiwify.com/pacote-completo-upsell', '_blank');
}

function declineUpsell() {
  // Esconder o upsell
  document.querySelector('.upsell-section').style.display = 'none';
}
</script>

